# Copia este archivo como .env y rellénalo. .env no se sube a git.

# Clave gratuita de Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Sueldo mínimo mensual en CLP. Las ofertas con sueldo publicado por debajo se descartan.
MIN_SALARY_CLP=1700000

# Correo (Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación").
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=
EMAIL_TO=tu_correo@gmail.com

# Telegram (opcional, se puede usar junto al correo o en su lugar).
# 1) Crea un bot con @BotFather (/newbot) y copia el token.
# 2) Escríbele cualquier mensaje a tu bot y ejecuta: .venv/Scripts/python scripts/telegram_chat_id.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
